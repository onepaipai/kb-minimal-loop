<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>kb-minimal-loop</artifactId>
    <version>1.0.0</version>
    <name>kb-minimal-loop</name>
    <description>AI 知识库最小闭环：文档入库 + 检索问答</description>

    <properties>
        <java.version>17</java.version>
        <langchain4j.version>1.22.0</langchain4j.version>
        <langchain4j-pgvector.version>1.22.0-beta32</langchain4j-pgvector.version>
        <langchain4j-tika.version>1.22.0-beta32</langchain4j-tika.version>
    </properties>

    <dependencies>
        <!-- Web：REST 接口与 multipart 上传 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- JDBC：仅供 Spring 启动时执行 schema.sql 初始化表结构 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- LangChain4j 核心：Document、DocumentSplitters、EmbeddingStoreIngestor 等 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!-- OpenAI 兼容协议客户端：DeepSeek 聊天与 DashScope 向量都走该模块 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!-- pgvector 向量库存储实现（显式 pin beta 版） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-pgvector</artifactId>
            <version>${langchain4j-pgvector.version}</version>
        </dependency>
        <!-- Tika 文档解析（PDF/DOC/DOCX/MD 等）：传递依赖已含 Tika 3.2.3，严禁额外引入 Tika 4.x 或 tika-bom（Tika 4 改了 Parser.parse 签名，会运行时 NoSuchMethodError） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-document-parser-apache-tika</artifactId>
            <version>${langchain4j-tika.version}</version>
        </dependency>
        <!-- Actuator：健康检查与指标（/actuator/health 对外，metrics/prometheus 需登录） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Security：登录鉴权（BCrypt 密码 + JWT 过滤器），接口默认都要带 Bearer Token -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- JWT：签发与校验（0.12.6，api/impl/jackson 三件套） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <!-- PostgreSQL 驱动：Spring 执行 schema.sql 时使用 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Java 源码 AST 解析（代码知识库按方法切块用），不引入 javaparser-symbol-solver-core -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
            <version>3.27.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 启动入口：com.example.kb.KbApplication（仓库内只有这一套实现） -->
                    <mainClass>com.example.kb.KbApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
